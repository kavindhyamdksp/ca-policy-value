<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>PolicyValue CA ledger</title>
<style>
:root{--fg:#1d2330;--muted:#5b6475;--bg:#fff;--line:#d9dde5;--accent:#0b5cad;--warn:#8a5300;--chip:#eef1f6}
@media (prefers-color-scheme: dark){:root{--fg:#e6e9ef;--muted:#a3abba;--bg:#12151b;--line:#2c323d;--accent:#6aa8ff;--warn:#f0b35a;--chip:#1f242d}}
body{font:15px/1.5 system-ui,-apple-system,Segoe UI,sans-serif;color:var(--fg);background:var(--bg);max-width:1100px;margin:0 auto;padding:24px 16px}
h1{font-size:1.5rem;margin-bottom:.2rem}p.meta{color:var(--muted);margin-top:0}
table{border-collapse:collapse;width:100%;display:block;overflow-x:auto;font-size:.88rem}
th,td{border-bottom:1px solid var(--line);padding:6px 8px;text-align:left;vertical-align:top}
code{font-size:.85em}a{color:var(--accent)}.chip{background:var(--chip);border-radius:4px;padding:1px 6px;white-space:nowrap}
.stale{color:var(--warn);font-weight:600}details summary{cursor:pointer}details ul{margin:.3rem 0 .3rem 1rem;padding:0}
</style></head><body>
<h1>PolicyValue CA — policy ledger</h1>
<p class="meta">Ledger <code>{{ version }}</code> · sha256 <code>{{ digest[:12] }}</code> · {{ rows|length }} entries / {{ n_ids }} ids · freshness as of {{ as_of }} · generated by policyvalue-ca {{ engine }}</p>
<p>Every value is read from a cited, dated source. Legal status matters: <em>announced</em> and <em>proposed</em> values are scenarios, not law. Data: CC BY 4.0 with OGL-Canada attributions. Not tax, legal or investment advice.</p>
<table>
<thead><tr><th>Record</th><th>Status</th><th>Effective</th><th>Value</th><th>Retrieved</th><th>Sources</th></tr></thead>
<tbody>
{% for r in rows %}<tr id="{{ r.id }}--{{ r.effective_from }}--{{ r.legal_status }}">
<td><code>{{ r.id }}</code><br><small>{{ r.instrument }} · {{ r.parameter }}</small></td>
<td><span class="chip">{{ r.legal_status }}</span><br><small>confidence {{ r.confidence }}</small></td>
<td>{{ r.effective_from }}{% if r.effective_to %} → {{ r.effective_to }}{% endif %}</td>
<td><code>{{ r.value|tojson }}</code> {{ r.unit }}{% if r.currency_basis != "n/a" %} <small>({{ r.currency_basis }})</small>{% endif %}</td>
<td>{{ r.sources|map(attribute="retrieved")|max }}<br>{% if r.days_left < 0 %}<span class="stale">stale ({{ -r.days_left }} d past SLA)</span>{% else %}<small>{{ r.days_left }} d left ({{ r.freshness }})</small>{% endif %}</td>
<td><details><summary>{{ r.sources|length }} source{{ "s" if r.sources|length != 1 }}{% if not r.has_primary_source %} · secondary only{% endif %}</summary><ul>
{% for s in r.sources %}<li><a href="{{ s.url }}" rel="noopener">{{ s.publisher }}: {{ s.title }}</a> <small>({{ s.source_type }}; {{ s.locator }})</small>{% if s.excerpt %}<br><small>“{{ s.excerpt }}”</small>{% endif %}</li>
{% endfor %}</ul>{% if r.notes %}<small>{{ r.notes }}</small>{% endif %}</details></td>
</tr>
{% endfor %}</tbody></table>
</body></html>
